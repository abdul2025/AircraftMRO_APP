@AircraftMRO.Api_HostAddress = http://localhost:5146

# Interactive reference (Development only): {{AircraftMRO.Api_HostAddress}}/scalar
# OpenAPI document: {{AircraftMRO.Api_HostAddress}}/openapi/v1.json

### Find a country id (ISO 3166-1 list, seeded by the migration)
GET {{AircraftMRO.Api_HostAddress}}/api/countries?search=France

### Create a manufacturer (countryId from the country list)
POST {{AircraftMRO.Api_HostAddress}}/api/aircraft-manufacturers
Content-Type: application/json

{
  "name": "Airbus",
  "code": "AIB",
  "countryId": "{{countryId}}",
  "isActive": true
}

### Create a model under that manufacturer (categories: NarrowBody, WideBody, RegionalJet, Turboprop, BusinessJet, Helicopter, Other)
POST {{AircraftMRO.Api_HostAddress}}/api/aircraft-models
Content-Type: application/json

{
  "manufacturerId": "{{manufacturerId}}",
  "name": "A320-214",
  "modelCode": "A320-214",
  "aircraftCategory": "NarrowBody",
  "isActive": true
}

### List a manufacturer's models
GET {{AircraftMRO.Api_HostAddress}}/api/aircraft-models?manufacturerId={{manufacturerId}}&isActive=true

### Deactivate a model (existing aircraft keep it; new aircraft cannot choose it)
PUT {{AircraftMRO.Api_HostAddress}}/api/aircraft-models/{{modelId}}
Content-Type: application/json
If-Match: "{{etag}}"

{
  "name": "A320-214",
  "modelCode": "A320-214",
  "aircraftCategory": "NarrowBody",
  "isActive": false
}

### List aircraft
GET {{AircraftMRO.Api_HostAddress}}/api/aircraft?page=1&pageSize=20
Accept: application/json

### Create aircraft
POST {{AircraftMRO.Api_HostAddress}}/api/aircraft
Content-Type: application/json

{
  "registrationNumber": "HZ-ABC",
  "manufacturerId": "{{manufacturerId}}",
  "modelId": "{{modelId}}",
  "serialNumber": "5123",
  "yearOfManufacture": 2012,
  "totalFlightHours": 31250.5,
  "status": "Active"
}

### Get aircraft (copy the id from the create response; the ETag header is needed for PUT/DELETE)
GET {{AircraftMRO.Api_HostAddress}}/api/aircraft/{{id}}

### Update aircraft
PUT {{AircraftMRO.Api_HostAddress}}/api/aircraft/{{id}}
Content-Type: application/json
If-Match: "{{etag}}"

{
  "registrationNumber": "HZ-ABC",
  "manufacturerId": "{{manufacturerId}}",
  "modelId": "{{modelId}}",
  "serialNumber": "5123",
  "yearOfManufacture": 2012,
  "totalFlightHours": 31300.0,
  "status": "InMaintenance"
}

### Delete aircraft (soft delete)
DELETE {{AircraftMRO.Api_HostAddress}}/api/aircraft/{{id}}
If-Match: "{{etag}}"

### List maintenance orders (filters: workOrderId, status, type, open, overdue)
GET {{AircraftMRO.Api_HostAddress}}/api/maintenance-orders?open=true

### Schedule maintenance under an open work order
POST {{AircraftMRO.Api_HostAddress}}/api/maintenance-orders
Content-Type: application/json

{
  "workOrderId": "{{workOrderId}}",
  "type": "CCheck",
  "scheduledDate": "2026-12-01",
  "notes": "Hangar 2"
}

### Update maintenance (completing it is final)
PUT {{AircraftMRO.Api_HostAddress}}/api/maintenance-orders/{{maintenanceOrderId}}
Content-Type: application/json
If-Match: "{{etag}}"

{
  "type": "CCheck",
  "scheduledDate": "2026-12-01",
  "status": "Completed"
}

### Delete maintenance (only while Scheduled; soft delete)
DELETE {{AircraftMRO.Api_HostAddress}}/api/maintenance-orders/{{maintenanceOrderId}}
If-Match: "{{etag}}"

###
