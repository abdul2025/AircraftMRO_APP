@model LoginViewModel

<aside class="login-panel" aria-labelledby="login-title">
    <div class="login-panel__heading">
        <span class="login-panel__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14Z" /></svg>
        </span>
        <div>
            <h2 id="login-title">Team sign in</h2>
            <p>Use your work email and password to continue.</p>
        </div>
    </div>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="login-status" role="alert"></div>

        <div class="form-field">
            <label asp-for="Email">Work email</label>
            <input asp-for="Email" autocomplete="username" placeholder="name@company.com" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="form-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
            <span asp-validation-for="Password"></span>
        </div>
        <label class="remember-me" asp-for="RememberMe">
            <input asp-for="RememberMe" />
            <span>Keep me signed in</span>
        </label>
        <button class="button button--primary" type="submit">Sign in</button>
    </form>

    <p class="auth-switch">
        Need an account?
        <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
    </p>
</aside>
