@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="topbar-user">@(User.FindFirst(ApplicationClaimTypes.EmployeeId)?.Value ?? User.Identity?.Name)</span>
    <form asp-controller="Account" asp-action="Logout" method="post" class="topbar-logout-form">
        <button class="topbar-action" type="submit" aria-label="Sign out" title="Sign out">
            <svg class="topbar-action__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16 13v-2H7V8l-5 4 5 4v-3zM20 3h-9a2 2 0 0 0-2 2v4h2V5h9v14h-9v-4H9v4a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z" />
            </svg>
        </button>
    </form>
}
else
{
    <a class="topbar-action" asp-controller="Account" asp-action="Login" aria-label="Sign in" title="Sign in">
        <svg class="topbar-action__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14Z" />
        </svg>
    </a>
}
