@using AircraftMRO.Web.Features.Notifications
@using AircraftMRO.Web.Features.Aircraft.Models
@model NotificationBellViewModel

@* notifications.js reads the data-* URLs, keeps this list live, and computes the unread badge per browser. *@
<div class="dropdown notification-bell" data-notification-bell
     data-hub-url="@NotificationsHub.Path"
     data-since-url="@Url.Action("Since", "Notifications")"
     data-latest-id="@Model.LatestId">
    <button class="topbar-action notification-bell__button" type="button" data-bs-toggle="dropdown"
            data-bs-auto-close="outside" aria-expanded="false" aria-label="Notifications">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
        <span class="notification-bell__badge" data-notification-badge hidden></span>
    </button>
    <div class="dropdown-menu dropdown-menu-end notification-panel">
        <div class="notification-panel__header">
            <strong>Notifications</strong>
            <span class="notification-panel__status" data-notification-status>Connecting…</span>
        </div>
        <ol class="notification-list" data-notification-list>
            @foreach (var item in Model.Recent)
            {
                <li class="notification-item" data-notification-id="@item.Id">
                    @if (item.Url is not null)
                    {
                        <a class="notification-item__message" href="@item.Url">@item.Message</a>
                    }
                    else
                    {
                        <span class="notification-item__message">@item.Message</span>
                    }
                    <time class="notification-item__time" datetime="@AuditDisplay.MachineTimestamp(item.OccurredAtUtc)">@AuditDisplay.Timestamp(item.OccurredAtUtc)</time>
                </li>
            }
        </ol>
        <p class="notification-panel__empty" data-notification-empty @(Model.Recent.Count > 0 ? "hidden" : null)>No notifications yet.</p>
        <a class="notification-panel__footer" asp-controller="Notifications" asp-action="Index">View all notifications</a>
    </div>
</div>
