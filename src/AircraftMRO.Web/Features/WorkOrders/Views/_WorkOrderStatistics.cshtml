@model WorkOrderListViewModel
@{
    var statistics = Model.Statistics;
    string ListUrl(Dictionary<string, string> routeValues) => Url.Action("Index", (object)routeValues)!;

    var panel = new StatPanelViewModel(
        Label: "Work order summary",
        TotalLabel: "Total work orders",
        AllUrl: ListUrl(Model.RouteValues(keepFacets: false)),
        Breakdown: WorkOrderStatusChart.From(Model, status => ListUrl(Model.RouteValues(status: status, keepFacets: false))),
        Highlights:
        [
            new StatHighlight(
                "Open critical",
                NumberDisplay.Compact(statistics.OpenCountFor(WorkOrderPriority.Critical)),
                "danger",
                ListUrl(Model.RouteValues(priority: WorkOrderPriority.Critical, openOnly: true, keepFacets: false)),
                Model.IsFacet(priority: WorkOrderPriority.Critical, openOnly: true),
                "Show open critical work orders"),
            new StatHighlight(
                "Overdue",
                NumberDisplay.Compact(statistics.OverdueCount),
                "warning",
                ListUrl(Model.RouteValues(overdueOnly: true, keepFacets: false)),
                Model.IsFacet(overdueOnly: true),
                "Show open work orders past their due date")
        ],
        FacetLabel: Model.FacetLabel);
}

<partial name="_StatPanel" model="panel" />
