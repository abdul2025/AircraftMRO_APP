@model AircraftListViewModel
@{
    var statistics = Model.Statistics;
    var flightHours = statistics.TotalFlightHours;
    string ListUrl(Dictionary<string, string> routeValues) => Url.Action("Index", (object)routeValues)!;

    var panel = new StatPanelViewModel(
        Label: "Fleet summary",
        TotalLabel: "Total aircraft",
        AllUrl: ListUrl(Model.RouteValues(keepStatus: false)),
        Breakdown: FleetStatusChart.From(statistics, Model.Filter.Status, status => ListUrl(Model.RouteValues(status: status, keepStatus: false))),
        Highlights:
        [
            new StatHighlight(
                "Fleet flight hours",
                NumberDisplay.Compact(decimal.Round(flightHours)),
                "neutral",
                Title: $"{flightHours:N1} hours")
        ],
        FacetLabel: Model.Filter.Status is { } status ? AircraftStatusLabels.ToLabel(status) : null);
}

<partial name="_StatOverview" model="panel" />
