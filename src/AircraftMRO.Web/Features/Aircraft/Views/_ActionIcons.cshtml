@model AircraftActionsViewModel

<div class="row-actions">
    <a class="icon-button" asp-action="Edit" asp-route-id="@Model.Id" data-modal
       aria-label="Edit @Model.RegistrationNumber" title="Edit">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4L18.5 9.5a2.83 2.83 0 0 0-4-4L4 16v4Z" /><path d="m13.5 6.5 4 4" /></svg>
    </a>
    <a class="icon-button icon-button--danger" asp-action="Delete" asp-route-id="@Model.Id" data-modal
       aria-label="Delete @Model.RegistrationNumber" title="Delete">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16" /><path d="M10 11v6M14 11v6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12" /><path d="M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" /></svg>
    </a>
</div>
