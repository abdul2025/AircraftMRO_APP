@model AircraftDetailsViewModel
@{
    ViewData["Title"] = Model.RegistrationNumber;
}

@* live-refresh.js re-renders this page when this aircraft changes, and returns to the list if it is deleted. *@
<section class="form-card" aria-labelledby="details-title"
         data-live-refresh="Aircraft" data-live-refresh-id="@Model.Id" data-live-refresh-gone="@Url.Action("Index")">
    <div class="card-heading">
        <div>
            <p class="eyebrow">Aircraft</p>
            <h1 id="details-title">@Model.RegistrationNumber</h1>
        </div>
        <partial name="_ActionIcons" model="new AircraftActionsViewModel(Model.Id, Model.RegistrationNumber)" />
    </div>

    <partial name="_StatusMessages" />
    <partial name="_AircraftSummary" model="Model" />

    <section class="audit-panel" aria-labelledby="work-orders-title">
        <h2 id="work-orders-title" class="subheading">Work orders</h2>
        <p class="lead-text">
            Open work orders set this aircraft's status: grounded while any is critical, in maintenance otherwise,
            and back to Active when the last one is completed or cancelled.
        </p>
        <div class="form-actions">
            <a class="button button--secondary" asp-controller="WorkOrders" asp-action="Index" asp-route-aircraftId="@Model.Id">View work orders</a>
            @if (Model.Status != AircraftStatus.Retired)
            {
                <a class="button button--primary" asp-controller="WorkOrders" asp-action="Create" asp-route-aircraftId="@Model.Id" data-modal>New work order</a>
            }
        </div>
    </section>

    <section class="audit-panel" aria-labelledby="audit-title">
        <h2 id="audit-title" class="subheading">Audit trail</h2>
        <dl class="detail-list detail-list--muted">
            <div>
                <dt>Created</dt>
                <dd><time datetime="@AuditDisplay.MachineTimestamp(Model.CreatedAtUtc)">@AuditDisplay.Timestamp(Model.CreatedAtUtc)</time></dd>
            </div>
            <div>
                <dt>Created by</dt>
                <dd>@AuditDisplay.User(Model.CreatedBy)</dd>
            </div>
            <div>
                <dt>Last updated</dt>
                <dd>
                    @if (Model.UpdatedAtUtc is { } updatedAt)
                    {
                        <time datetime="@AuditDisplay.MachineTimestamp(updatedAt)">@AuditDisplay.Timestamp(updatedAt)</time>
                    }
                    else
                    {
                        <span>Never updated</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Last updated by</dt>
                <dd>@(Model.UpdatedAtUtc is null ? "—" : AuditDisplay.User(Model.UpdatedBy))</dd>
            </div>
            <div>
                <dt>Record ID</dt>
                <dd><code class="record-id">@Model.Id</code></dd>
            </div>
        </dl>
    </section>

    <div class="form-actions">
        <a class="button button--secondary" asp-action="Index">Back to aircraft</a>
    </div>
</section>
