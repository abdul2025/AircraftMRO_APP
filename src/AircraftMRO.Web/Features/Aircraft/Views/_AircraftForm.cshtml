@model AircraftFormViewModel

<div asp-validation-summary="ModelOnly" class="notice notice--danger" role="alert"></div>
<input type="hidden" asp-for="RowVersion" />

<div class="form-grid">
    <div class="form-field">
        <label asp-for="RegistrationNumber"></label>
        <input asp-for="RegistrationNumber" autocomplete="off" placeholder="HZ-ABC" />
        <span asp-validation-for="RegistrationNumber" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="AircraftStatusLabels.Options()"></select>
        <span asp-validation-for="Status" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="ManufacturerId"></label>
        <select asp-for="ManufacturerId">
            <option value="">Select a manufacturer</option>
            @foreach (var manufacturer in Model.Options.Manufacturers)
            {
                <option value="@manufacturer.Id" selected="@(Model.ManufacturerId == manufacturer.Id)">@manufacturer.Name@(manufacturer.IsActive ? "" : " (inactive)")</option>
            }
        </select>
        <span asp-validation-for="ManufacturerId" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="ModelId"></label>
        @* dependent-select.js hides the models of other manufacturers when the manufacturer changes. *@
        <select asp-for="ModelId" data-depends-on="@Html.IdFor(m => m.ManufacturerId)">
            <option value="">Select a model</option>
            @foreach (var option in Model.Options.Models)
            {
                var otherManufacturer = Model.ManufacturerId is { } selected && selected != option.ManufacturerId;
                <option value="@option.Id" data-parent="@option.ManufacturerId" hidden="@otherManufacturer" disabled="@otherManufacturer"
                        selected="@(Model.ModelId == option.Id)">@option.Name (@option.ModelCode)@(option.IsActive ? "" : " (inactive)")</option>
            }
        </select>
        <span asp-validation-for="ModelId" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="SerialNumber"></label>
        <input asp-for="SerialNumber" autocomplete="off" />
        <span asp-validation-for="SerialNumber" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="YearOfManufacture"></label>
        <input asp-for="YearOfManufacture" inputmode="numeric" />
        <span asp-validation-for="YearOfManufacture" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="TotalFlightHours"></label>
        <input asp-for="TotalFlightHours" step="0.1" min="0" inputmode="decimal" />
        <span asp-validation-for="TotalFlightHours" class="field-error"></span>
    </div>
</div>
