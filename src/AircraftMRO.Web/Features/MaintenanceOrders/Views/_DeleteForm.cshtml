@model MaintenanceOrderDetailsViewModel

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-modal-form>
    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
    <div class="modal-header">
        <div>
            <p class="eyebrow">Maintenance</p>
            <h2 class="modal-title" id="maintenance-order-form-title">Delete @Model.Title?</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        @if (!Model.CanBeDeleted)
        {
            <p class="notice notice--danger" role="alert">
                Only scheduled maintenance can be deleted. Started or completed maintenance is kept as history.
            </p>
        }
        else
        {
            <p class="lead-text">
                The maintenance will be removed from the list. Its record is kept for audit.
            </p>
        }
        <partial name="_StatusMessages" />
        <partial name="_MaintenanceOrderSummary" model="Model" />
    </div>
    <div class="modal-footer">
        <a class="button button--secondary" asp-action="Details" asp-route-id="@Model.Id" data-bs-dismiss="modal">Cancel</a>
        @if (Model.CanBeDeleted)
        {
            <button type="submit" class="button button--danger">Delete maintenance</button>
        }
    </div>
</form>
