@model AircraftModelDetailsViewModel

<dl class="detail-list">
    <div><dt>Manufacturer</dt><dd><a asp-controller="AircraftManufacturers" asp-action="Details" asp-route-id="@Model.ManufacturerId">@Model.ManufacturerName</a></dd></div>
    <div><dt>Name</dt><dd>@Model.Name</dd></div>
    <div><dt>Model code</dt><dd>@Model.ModelCode</dd></div>
    <div><dt>Aircraft category</dt><dd>@AircraftModelLabels.ToLabel(Model.AircraftCategory)</dd></div>
    <div><dt>Status</dt><dd><partial name="_ActiveBadge" model="Model.IsActive" /></dd></div>
</dl>
